{
  "name": "noveler-ai",
  "displayName": "Noveler AI",
  "description": "NOVELER AI助手插件",
  "version": "1.4.13",
  "author": "zerozawa",
  "publisher": "zerozawa",
  "license": "GPL-3.0",
  "scripts": {
    "vscode:prepublish": "npm run compile-prod",
    "prepare": "husky install",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies -p",
    "compile-prod": "concurrently npm:compile-prod:*",
    "compile-prod:webview": "cd ./packages/webview && npm run compile-prod",
    "compile-prod:extension": "cd ./packages/extension && npm run compile-prod",
    "compile": "concurrently npm:compile:*",
    "compile:webview": "cd ./packages/webview && npm run compile",
    "compile:extension": "cd ./packages/extension && npm run compile",
    "watch": "concurrently npm:watch:*",
    "watch:webview": "cd ./packages/webview && npm run watch",
    "watch:extension": "cd ./packages/extension && npm run watch",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "prettier": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "lint-staged": "lint-staged",
    "commit": "cz",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@faker-js/faker": "^7.6.0",
    "@types/node": "^16.18.126",
    "@types/prettier": "^2.7.3",
    "@types/vscode": "^1.77.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/vsce": "^2.32.0",
    "commitizen": "^4.3.1",
    "concurrently": "^7.6.0",
    "conventional-changelog-cli": "^2.2.2",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "prettier": "^2.8.8",
    "speed-measure-webpack-plugin": "^1.5.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "uglifyjs-webpack-plugin": "^2.2.0",
    "webpack": "^5.98.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^4.10.0"
  },
  "engines": {
    "vscode": "^1.77.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lz37/noveler"
  },
  "extensionKind": [
    "workspace"
  ],
  "qna": "marketplace",
  "categories": [
    "Other"
  ],
  "keywords": [
    "novel",
    "小说",
    "小説",
    "plaintext",
    "markdown"
  ],
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "noveler.aiChat",
        "title": "打开对话页面",
        "category": "noveler",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "noveler.aiRandomName",
        "title": "随机取名",
        "category": "noveler"
      },
      {
        "command": "noveler.aiWordReplace",
        "title": "词汇替换",
        "category": "noveler"
      },
      {
        "command": "noveler.aiContinueWriting",
        "title": "续写",
        "category": "noveler"
      },
      {
        "command": "noveler.aiCharacterDesign",
        "title": "角色设计",
        "category": "noveler"
      }
    ],
    "submenus": [
      {
        "id": "noveler.ai.submenu",
        "label": "NOVELER AI助手"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "noveler.ai.submenu",
          "group": "navigation",
          "when": "editorTextFocus",
          "label": "NOVELER AI助手"
        }
      ],
      "noveler.ai.submenu": [
        {
          "command": "noveler.aiChat",
          "group": "ai@0"
        },
        {
          "command": "noveler.aiRandomName",
          "group": "ai@1"
        },
        {
          "command": "noveler.aiWordReplace",
          "group": "ai@2"
        },
        {
          "command": "noveler.aiContinueWriting",
          "group": "ai@3"
        },
        {
          "command": "noveler.aiCharacterDesign",
          "group": "ai@4"
        }
      ]
    },
    "colors": [
      {
        "id": "number",
        "description": "数字的颜色",
        "defaults": {
          "dark": "#6cd8e6",
          "light": "#3c8dbc"
        }
      }
    ],
    "configuration": {
      "title": "Noveler",
      "properties": {
        "noveler.ai.apiProviders": {
          "type": "array",
          "default": [],
          "markdownDescription": "AI API 提供商列表",
          "scope": "resource",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "markdownDescription": "提供商的唯一标识符"
              },
              "name": {
                "type": "string",
                "markdownDescription": "提供商的显示名称"
              },
              "apiUrl": {
                "type": "string",
                "markdownDescription": "API 的 URL 地址"
              },
              "apiKey": {
                "type": "string",
                "markdownDescription": "API 的密钥"
              },
              "models": {
                "type": "array",
                "markdownDescription": "该提供商支持的模型列表",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "markdownDescription": "模型的唯一标识符"
                    },
                    "name": {
                      "type": "string",
                      "markdownDescription": "模型的显示名称"
                    },
                    "isActive": {
                      "type": "boolean",
                      "markdownDescription": "模型是否激活",
                      "default": true
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ]
                }
              },
              "isActive": {
                "type": "boolean",
                "markdownDescription": "提供商是否激活",
                "default": true
              }
            },
            "required": [
              "id",
              "name",
              "apiUrl",
              "apiKey",
              "models"
            ]
          }
        },
        "noveler.ai.selectedProviderId": {
          "type": "string",
          "default": "",
          "markdownDescription": "当前选中的API提供商ID",
          "scope": "resource"
        },
        "noveler.ai.selectedModelId": {
          "type": "string",
          "default": "",
          "markdownDescription": "当前选中的模型ID",
          "scope": "resource"
        },
        "noveler.ai.prompts": {
          "type": "object",
          "default": {
            "randomName": {
              "withSelection": "请根据内容：${selectedText}，随机取十个适合小说的人物姓名",
              "withoutSelection": "请随机生成十个适合小说的人物姓名"
            },
            "wordReplace": {
              "withSelection": "[${paragraphText}]\n${selectedText}能替换成什么？",
              "withoutSelection": "请为当前段落提供一些词汇替换建议：\n${paragraphText}"
            },
            "continueWriting": {
              "withSelection": "请根据选中的内容继续续写：\n${selectedText}",
              "withoutSelection": "请根据以下内容继续续写：\n${contentText}"
            },
            "characterDesign": {
              "withSelection": "请根据以下内容设计一个角色：\n${selectedText}",
              "withoutSelection": "帮我随机设计一个角色"
            }
          },
          "markdownDescription": "AI 提示词配置，可使用占位符：${selectedText}（选中文本）、${selectedTextWithContext}（选中文本及上下文）、${contentText}（全文）、${paragraphText}（当前段落）",
          "scope": "resource",
          "properties": {
            "randomName": {
              "type": "object",
              "markdownDescription": "随机取名提示词",
              "properties": {
                "withSelection": {
                  "type": "string",
                  "markdownDescription": "有选中文本时的提示词"
                },
                "withoutSelection": {
                  "type": "string",
                  "markdownDescription": "无选中文本时的提示词"
                }
              }
            },
            "wordReplace": {
              "type": "object",
              "markdownDescription": "词汇替换提示词",
              "properties": {
                "withSelection": {
                  "type": "string",
                  "markdownDescription": "有选中文本时的提示词"
                },
                "withoutSelection": {
                  "type": "string",
                  "markdownDescription": "无选中文本时的提示词"
                }
              }
            },
            "continueWriting": {
              "type": "object",
              "markdownDescription": "续写提示词",
              "properties": {
                "withSelection": {
                  "type": "string",
                  "markdownDescription": "有选中文本时的提示词"
                },
                "withoutSelection": {
                  "type": "string",
                  "markdownDescription": "无选中文本时的提示词"
                }
              }
            },
            "characterDesign": {
              "type": "object",
              "markdownDescription": "角色设计提示词",
              "properties": {
                "withSelection": {
                  "type": "string",
                  "markdownDescription": "有选中文本时的提示词"
                },
                "withoutSelection": {
                  "type": "string",
                  "markdownDescription": "无选中文本时的提示词"
                }
              }
            }
          }
        }
      }
    }
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808"
}
